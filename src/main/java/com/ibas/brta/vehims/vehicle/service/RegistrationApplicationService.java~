    public PagedResponse<VehRegistrationApplicationDTO> searchVehRegApplicationsForMvi(int page, int size, ApplicationFilterRequest filters) {

        Utils.validatePageNumberAndSize(page, size);

        // Retrieve
        Pageable pageable = PageRequest.of(page, size);

        Long orgId = Utils.getLoggedInOrgId();

        log.info("orgId================== {}", orgId);

        filters.setOrgId(orgId);

//        roleURepository.findBy

        //dl_exam_submission
        Long permissionId = 68L;

//        LocalDate applicationDateLocal = LocalDate.from(applicationDate.toInstant());

//        System.out.println("Application Date: " + applicationDate + ", Type: " + (applicationDate != null ? applicationDate.getClass() : "null"));

//        Page<DrivingLicenseApplicationDto> records = drivingLicenseRepository.searchDrivingLicenseApplications(
        Page<VehRegistrationApplicationDTO> records = vehicleDao.searchVehRegApplicationsForMvi(pageable, filters);

        Long count = 1L;
        for (VehRegistrationApplicationDTO record : records.getContent()) {
            record.setSl(count);
            count++;
        }

        if (records.getNumberOfElements() == 0) {
            return new PagedResponse<>(Collections.emptyList(), records.getNumber(),
                    records.getSize(), records.getTotalElements(), records.getTotalPages(), records.isLast());
        }

        return new PagedResponse<>(records.stream().toList(), records.getNumber(),
                records.getSize(), records.getTotalElements(), records.getTotalPages(), records.isLast());
    }

    private void validatePageNumberAndSize(int page, int size) {
        if (page < 0) {
            throw new BadRequestException("Page number cannot be less than zero.");
        }

        if (size > AppConstants.MAX_PAGE_SIZE) {
            throw new BadRequestException("Page size must not be greater than " + AppConstants.MAX_PAGE_SIZE);
        }
    }

    public Object getVehicleRegistrationReport(VehicleRegReportFilterRequest request) {
        Map<String, Object> customArray = new HashMap<>();

        Long orgId = request.getOrgId();
        Long vehicleTypeId = request.getVehicleTypeId();
        Long ownerTypeId = request.getOwnerTypeId();
        String applicationDate = null;

        log.info("request.getApplicationDate() ---> {}", request.getApplicationDate());

        if (!request.getApplicationDate().isEmpty()) {
            applicationDate = request.getApplicationDate();
        }

        Long serviceId = 14L;
        Long applicationStatusId;

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_draft");
        Long draftedApplications = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("draftedApplications", draftedApplications);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_pending");
        Long submittedForInspection = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("submittedForInspection", submittedForInspection);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_primary_rejected");
        Long inspectionApproved = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("inspectionApproved", inspectionApproved);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_primary_rejected");
        Long inspectionRejected = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("inspectionRejected", inspectionRejected);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_final_submitted");
        Long applicationForRegistrations = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("applicationForRegistrations", applicationForRegistrations);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_final_approved");
        Long registeredVehicles = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("registeredVehicles", registeredVehicles);

        applicationStatusId = commonRepository.getStatusIdByStatusCode("vehicle_app_final_rejected");
        Long vehicleRegistrationRejected = applicationRepository.getVehicleRegistrationReport(serviceId, applicationStatusId, orgId, vehicleTypeId, ownerTypeId, applicationDate);
        customArray.put("vehicleRegistrationRejected", vehicleRegistrationRejected);

        return customArray;
    }
